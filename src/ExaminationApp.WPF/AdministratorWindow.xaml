<Window x:Class="ExaminationApp.WPF.AdministratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExaminationApp.WPF"
        mc:Ignorable="d"
        Title="AdministratorWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Назад" Margin="10,20,726,20" Background="#D2F6E7" Click="OnOpenMainWindow" MaxWidth="80"/>
        <Label Grid.Row="0" Content="Административная панель" FontSize="22" FontWeight="Bold" Margin="234,10,234,10"/>
        <ListBox x:Name="OrderList" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch" MouseDoubleClick="OnOrderDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#D2F6E7" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="20" Text="{Binding OrderTitle}" FontWeight="SemiBold" Margin="20,5"/>
                                <TextBlock FontSize="16" Text="{Binding CustomerFio}" Margin="5,5"/>
                                <TextBlock FontSize="16" Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Margin="5,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding TotalPrice, StringFormat={}{0:F2} р.}" HorizontalAlignment="Right" Margin="12,20"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
