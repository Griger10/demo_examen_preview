<Window x:Class="ExaminationApp.WPF.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа" Height="500" Width="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="OrderTitle" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="  Дата заказа:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <DatePicker x:Name="OrderDatePicker" Width="140"/>
            <Button x:Name="SaveDateButton" Content="Сохранить дату" Margin="8,0" Padding="8,3"
                    Click="OnSaveDate"/>
        </StackPanel>
        <ListBox x:Name="ItemsList" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#B8CEC5" BorderThickness="1" CornerRadius="5" Padding="8" Margin="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProductInfo}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}Кол-во: {0}}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:F2} ₽/шт.}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat={}{0:F2} ₽}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="Удалить" Padding="8,3" Margin="8,0,0,0"
                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                    Tag="{Binding OrderRowId}" Click="OnDeleteItem"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="OrderTotal" FontSize="18" FontWeight="Bold" DockPanel.Dock="Right"/>
            <Button Content="Закрыть" HorizontalAlignment="Left" Padding="12,5" Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
