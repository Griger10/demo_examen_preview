<Window x:Class="ExaminationApp.WPF.ProductOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExaminationApp.WPF"
        mc:Ignorable="d"
        Title="ProductOrderWindow" Height="450" Width="450">
    <Grid>
        <Button Background="#D2F6E7" Content="Назад" HorizontalAlignment="Left" Margin="18,10,0,0" VerticalAlignment="Top" Width="46"/>
        <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Добавление в корзину" VerticalAlignment="Top" Width="182"/>
        <TextBlock HorizontalAlignment="Left" Margin="18,60,0,0" TextWrapping="Wrap" Text="Выберите размер:" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="18,125,0,0" TextWrapping="Wrap" Text="Введите количество:" VerticalAlignment="Top"/>
        <ComboBox x:Name="SizesSelect" HorizontalAlignment="Left" Margin="144,57,0,0" VerticalAlignment="Top" Width="104" Height="19"/>
        <TextBox x:Name="Quantity" HorizontalAlignment="Left" Margin="144,123,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button FontSize="20" Content="Добавить в корзину" Background="#D2F6E7" HorizontalAlignment="Center" Margin="0,319,0,0" VerticalAlignment="Top" Click="OnAddToCart"/>
    </Grid>
</Window>
